    "cli"
  ],
  "license": "MIT",
  "author": "Artur Sedlukha",
  "homepage": "https://github.com/sedlukha/config-rollout#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sedlukha/config-rollout.git"
  },
  "bugs": {
    "url": "https://github.com/sedlukha/config-rollout/issues"
  },
  "type": "module",
  "bin": {
